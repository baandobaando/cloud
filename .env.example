# Copy to .env and fill in. Load with: node --env-file=.env server/index.ts (or set these in your host's dashboard).

NODE_ENV=production
PORT=3001
# Public URL of the site — used for payment redirects and webhook URLs.
APP_URL=https://binge.tube
# Where the SQLite database and uploaded videos/posters are stored. Put this on a persistent disk.
DATA_DIR=./data

# First admin account (created on startup if it doesn't exist).
ADMIN_EMAIL=you@example.com
ADMIN_PASSWORD=change-me-to-something-long

# --- Stripe (https://dashboard.stripe.com) ---
# Developers → API keys: the secret key (sk_live_… or sk_test_… while testing).
# Developers → Webhooks → Add endpoint: https://binge.tube/api/billing/webhooks/stripe with events
#   checkout.session.completed, checkout.session.async_payment_succeeded,
#   checkout.session.async_payment_failed, checkout.session.expired
# then copy that endpoint's signing secret (whsec_…).
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# --- BTCPay Server (https://btcpayserver.org) ---
# Account → API keys: create a key with "btcpay.store.cancreateinvoice" and "btcpay.store.canviewinvoices".
# Store → Settings → Webhooks: add https://YOUR_APP_URL/api/billing/webhooks/btcpay (all invoice events), copy the secret.
BTCPAY_URL=https://btcpay.example.com
BTCPAY_API_KEY=
BTCPAY_STORE_ID=
BTCPAY_WEBHOOK_SECRET=

# --- Bunny Stream (video hosting) ---
# Stream → your library → API tab: Library ID, API Key and CDN Hostname.
BUNNY_LIBRARY_ID=
BUNNY_LIBRARY_KEY=
BUNNY_CDN_HOST=
# Token authentication key (library Security tab). Set it only when CDN token authentication is on.
BUNNY_TOKEN_KEY=
# sha256 or hmac — run `npm run bunny:check` to see which one your library accepts.
BUNNY_TOKEN_MODE=sha256
# Sync shows from Bunny on startup and then every BUNNY_SYNC_MINUTES (set to off to disable).
BUNNY_AUTO_IMPORT=on
BUNNY_SYNC_MINUTES=5
# During each sync, delete every resolution except the highest on finished videos (off to disable).
BUNNY_KEEP_HIGHEST_ONLY=on

# Sign in with Google (free): console.cloud.google.com > APIs & Services > Credentials >
# Create OAuth client ID > Web application. Authorized redirect URI:
#   https://binge.tube/api/auth/oauth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Sign in with Apple (needs the $99/yr Apple Developer Program): a Services ID (APPLE_CLIENT_ID)
# with return URL https://binge.tube/api/auth/oauth/apple/callback, your Team ID, and a
# "Sign in with Apple" key (.p8). Paste the .p8 contents on one line with \n for line breaks.
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=
