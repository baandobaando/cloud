# Copy to .env and fill in. Load with: node --env-file=.env server/index.ts (or set these in your host's dashboard).

NODE_ENV=production
PORT=3001
# Public URL of the site — used for payment redirects and webhook URLs.
APP_URL=https://reelflix.example.com
# Where the SQLite database and uploaded videos/posters are stored. Put this on a persistent disk.
DATA_DIR=./data

# First admin account (created on startup if it doesn't exist).
ADMIN_EMAIL=you@example.com
ADMIN_PASSWORD=change-me-to-something-long

# --- NOWPayments (https://nowpayments.io) ---
# Dashboard → Store settings → API keys, and Payment settings → IPN secret.
NOWPAYMENTS_API_KEY=
NOWPAYMENTS_IPN_SECRET=
# Set to true to use https://api-sandbox.nowpayments.io while testing.
NOWPAYMENTS_SANDBOX=false

# --- BTCPay Server (https://btcpayserver.org) ---
# Account → API keys: create a key with "btcpay.store.cancreateinvoice" and "btcpay.store.canviewinvoices".
# Store → Settings → Webhooks: add https://YOUR_APP_URL/api/billing/webhooks/btcpay (all invoice events), copy the secret.
BTCPAY_URL=https://btcpay.example.com
BTCPAY_API_KEY=
BTCPAY_STORE_ID=
BTCPAY_WEBHOOK_SECRET=
