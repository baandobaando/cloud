{
  "expo": {
    "name": "BingeTube",
    "slug": "bingetube",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "tube.binge.app",
      "buildNumber": "1",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "tube.binge.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0a0a0b"
      }
    },
    "plugins": [
      "expo-router",
      "expo-status-bar",
      "expo-video",
      "expo-image",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 140,
          "backgroundColor": "#0a0a0b"
        }
      ]
    ],
    "scheme": "bingetube",
    "backgroundColor": "#0a0a0b"
  }
}
