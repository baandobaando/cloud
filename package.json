{
  "name": "reelflix",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:web": "vite",
    "dev:server": "node --watch --no-warnings server/index.ts",
    "build": "npm run typecheck && vite build",
    "start": "NODE_ENV=production node --no-warnings server/index.ts",
    "typecheck": "tsc -b && tsc -p server/tsconfig.json",
    "test": "node --no-warnings --test server/*.test.ts",
    "build:demo": "node scripts/build-demo.mjs",
    "bunny:check": "node --no-warnings scripts/bunny-check.mjs"
  },
  "dependencies": {
    "express": "^5.2.1",
    "hls.js": "^1.7.3",
    "multer": "^2.4.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router-dom": "^7.18.4"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/multer": "^2.3.0",
    "@types/node": "^22.20.5",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.1.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.2"
  },
  "engines": {
    "node": ">=22.18"
  }
}
